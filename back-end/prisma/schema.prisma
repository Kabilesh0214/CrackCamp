generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(uuid())
  username String
  email    String  @unique
  password String
  role     Role?

  selfIntros      SelfIntro[]
  conversations   Conversation[]
  mcqAttempts     McqAttempt[]
  dsaProgress     DsaProgress[]
  resumeAnalyses  ResumeAnalysis[]
  refreshTokens   RefreshToken[]
}

model Conversation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  messages  Message[]
  createdAt DateTime @default(now())
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  role           String
  content        String

  createdAt      DateTime @default(now())
}

model SelfIntro {
  id          String   @id @default(uuid())
  title       String?
  description String?
  videoUrl    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  WebDeveloper
  DataAnalyst
  ApplicationDeveloper
  CloudEngineer
  CybersecurityAnalyst
  MachineLearningEngineer
}

model ResourceTutorial {
  id          Int   @id @default(autoincrement())
  role        Role
  skill       String
  source      String
  url         String
  description String
  imageURL    String
  cost        Int   @default(0)
}

model Skill {
  id         Int @id @default(autoincrement())
  skill      String
  role       Role
}

model McqQuestion {
  id            Int      @id @default(autoincrement())
  role          Role
  category      String
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String   // "A" | "B" | "C" | "D"
  explanation   String
}

model McqAttempt {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String
  score       Int
  total       Int
  completedAt DateTime @default(now())
}

model DsaProgress {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId         Int      // matches the frontend dsaTopics[].id
  subtopicName    String
  completed       Boolean  @default(true)
  completedAt     DateTime @default(now())

  @@unique([userId, topicId, subtopicName])
}

model ResumeAnalysis {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName       String
  overallScore   Int
  summary        String
  strengths      String[] // PostgreSQL text array
  weaknesses     String[]
  missingKeywords String[]
  improvementTips String[]
  analysedAt     DateTime @default(now())
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model InterviewQuestion {
  id         Int    @id @default(autoincrement())
  role       Role
  category   String // "Behavioral" | "Technical" | "System Design"
  difficulty String // "Easy" | "Medium" | "Hard"
  question   String
  answer     String
}